# Root environment for docker compose. Copy to .env: Copy-Item .env.example .env
# Placeholder values only. Never commit the real .env.

# PostgreSQL. docker compose builds the API's DATABASE_URL from these, so the
# password must be URL-safe (letters, digits, - . _ ~). Change it for anything
# beyond a local review, and keep backend/.env.pg in sync for PG e2e.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Swagger UI at /api/docs (off by default in the containers)
ENABLE_SWAGGER=false

# LLM (optional). Without a key the API infers skills with keyword rules.
# Use your own key (https://aistudio.google.com/apikey); it is passed to the api
# container at runtime only and never reaches the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_CREATE_TASK_LIMIT=10
