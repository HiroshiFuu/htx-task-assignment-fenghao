# Root environment for docker compose. Copy to .env: Copy-Item .env.example .env
# Placeholder values only. Never commit the real .env.

# PostgreSQL (db service)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# API (used from Phase P6; inside compose the host is the `db` service)
DATABASE_URL=postgresql://app:change-me@db:5432/tasks
PORT=3000
ENABLE_SWAGGER=false

# LLM (optional: without a key the API falls back to the keyword classifier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_CREATE_TASK_LIMIT=10
