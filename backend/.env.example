# Local development (SQLite). Copy to .env: Copy-Item .env.example .env
DATABASE_URL="file:./prisma/dev.db"

PORT=3000
NODE_ENV=development
ENABLE_SWAGGER=true

# Optional. Without a key the app falls back to the keyword classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_CREATE_TASK_LIMIT=10
