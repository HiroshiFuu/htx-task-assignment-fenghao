// PostgreSQL schema: the single source of truth.
// The local SQLite schema is generated from this file by scripts/gen-sqlite-schema.ts.
// Connection URLs live in prisma.config.ts (Prisma 7), not here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

model Skill {
  id         String           @id @default(uuid()) @db.Uuid
  name       String           @unique @db.VarChar(50)
  developers DeveloperSkill[]
  tasks      TaskSkill[]

  @@map("skills")
}

model Developer {
  id     String           @id @default(uuid()) @db.Uuid
  name   String           @db.VarChar(100)
  skills DeveloperSkill[]
  tasks  Task[]

  @@map("developers")
}

model DeveloperSkill {
  developerId String    @map("developer_id") @db.Uuid
  skillId     String    @map("skill_id") @db.Uuid
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([developerId, skillId])
  @@index([skillId], map: "idx_dev_skills_skill")
  @@map("developer_skills")
}

model Task {
  id         String      @id @default(uuid()) @db.Uuid
  // CHECK (length(trim(title)) > 0) is added by hand in the PG init migration;
  // SQLite has no such constraint, so the application layer must validate titles.
  title      String      @db.VarChar(500)
  status     TaskStatus  @default(TODO)
  assigneeId String?     @map("assignee_id") @db.Uuid
  assignee   Developer?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  parentId   String?     @map("parent_id") @db.Uuid
  parent     Task?       @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks   Task[]      @relation("TaskTree")
  // Sibling order (1.1 before 1.2). Siblings are created in one request and can
  // share created_at, and their random UUIDs carry no order.
  position   Int         @default(0)
  skills     TaskSkill[]
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([assigneeId], map: "idx_tasks_assignee_id")
  @@index([parentId], map: "idx_tasks_parent_id")
  @@map("tasks")
}

model TaskSkill {
  taskId  String @map("task_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([taskId, skillId])
  @@index([skillId], map: "idx_task_skills_skill")
  @@map("task_skills")
}
